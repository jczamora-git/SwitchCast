<Page
    x:Class="SwitchCast.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SwitchCast.Models"
    xmlns:vm="using:SwitchCast.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="28,20,28,28" MaxWidth="1040" HorizontalAlignment="Left">
            
            <!-- Header & Secondary Actions -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="Presentation"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    <TextBlock Text="Live preview, source switching, and dedicated presentation output."
                               FontSize="12"
                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                </StackPanel>

                <!-- Header Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.OpenPresentationWindowCommand}"
                            Padding="12,6"
                            ToolTipService.ToolTip="Open or bring presentation output window to front">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE78B;" FontSize="13" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            <TextBlock Text="Output Window" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.TogglePresenterDockCommand}"
                            Padding="12,6"
                            ToolTipService.ToolTip="Toggle compact floating presenter dock">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7F4;" FontSize="13" Foreground="{ThemeResource AppAccentBrush}" />
                            <TextBlock Text="Presenter Dock" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Status Strip -->
            <Grid Padding="14,10"
                  Background="{ThemeResource AppSurfaceBrush}"
                  BorderBrush="{ThemeResource AppBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Presentation Status -->
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="STATUS"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.StatusDisplayText, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Active Source -->
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="ACTIVE SOURCE"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextTertiaryBrush}" />
                    <Grid ColumnSpacing="6" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind ViewModel.ActiveSourceTitle, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   MaxLines="1"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.ActiveSourceTitle, Mode=OneWay}" />
                    </Grid>
                </StackPanel>

                <!-- Queued Count -->
                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="QUEUED SOURCES"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedSourceCount, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        <TextBlock Text="ready"
                                   FontSize="11"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Output Window Status -->
                <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="OUTPUT WINDOW"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE78B;" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.PresentationOutputStatusText, Mode=OneWay}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Error Notification -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasCaptureError, Mode=OneWay}"
                     Severity="Error"
                     Title="Capture Alert"
                     Message="{x:Bind ViewModel.CaptureErrorMessage, Mode=OneWay}"
                     IsClosable="True" />

            <!-- Primary Presentation Control Bar -->
            <Border Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <!-- Start / Stop Presenting -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Presentation Source Selector (Normal or Empty State) -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Add Source Button -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Pause / Blackout -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Guidance Note -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Start / Stop Presenting Button -->
                    <Button Grid.Column="0"
                            Command="{x:Bind ViewModel.TogglePresentationCommand}"
                            IsEnabled="{x:Bind ViewModel.CanStartPresentation, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.StartPresentingTooltip, Mode=OneWay}"
                            Style="{StaticResource PrimaryAccentButtonStyle}"
                            Padding="16,8"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind ViewModel.PresentationButtonGlyph, Mode=OneWay}" FontSize="13" />
                            <TextBlock Text="{x:Bind ViewModel.PresentationButtonText, Mode=OneWay}" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <!-- Target Source Selector Container -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <!-- STATE 1: Sources exist in presentation queue (Normal ComboBox) -->
                        <ComboBox ItemsSource="{x:Bind ViewModel.SelectedSources, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedPresentationSource, Mode=TwoWay}"
                                  PlaceholderText="Select target source..."
                                  Visibility="{x:Bind ViewModel.HasSelectedSourcesVisibility, Mode=OneWay}"
                                  MinWidth="210"
                                  MaxWidth="280"
                                  VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:CaptureSource">
                                    <Grid ColumnSpacing="8" MaxWidth="250" ToolTipService.ToolTip="{x:Bind Title}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="{x:Bind TypeGlyph}" FontSize="12" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind Title}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   MaxLines="1"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- STATE 2: Zero queued sources (Empty-State Selector Button with Flyout) -->
                        <DropDownButton Visibility="{x:Bind ViewModel.NoSelectedSourcesVisibility, Mode=OneWay}"
                                        MinWidth="210"
                                        MaxWidth="280"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="10,6"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="No queued presentation sources. Click to manage sources.">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="12" Foreground="{ThemeResource AppTextTertiaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="No queued sources"
                                           FontSize="12"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           MaxLines="1"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <DropDownButton.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Background" Value="{ThemeResource AppSurfaceElevatedBrush}" />
                                            <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="CornerRadius" Value="8" />
                                            <Setter Property="Padding" Value="16" />
                                            <Setter Property="MaxWidth" Value="320" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                                        <!-- Header Title & Count -->
                                        <Grid Margin="0,0,0,2">
                                            <TextBlock Text="Queued Sources (0)"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <Rectangle Height="1" Fill="{ThemeResource AppSubtleDividerBrush}" Margin="0,0,0,4" />

                                        <!-- Empty State Visual -->
                                        <Border Width="40" Height="40"
                                                Background="{ThemeResource AppBadgeBackgroundBrush}"
                                                BorderBrush="{ThemeResource AppBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="20"
                                                HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource AppTextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Text="No queued sources"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   HorizontalAlignment="Center" />

                                        <TextBlock Text="Add application windows, displays, images, or videos from the Sources tab."
                                                   FontSize="11"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="260" />

                                        <!-- Action Button -->
                                        <Button Command="{x:Bind ViewModel.NavigateToSourcesCommand}"
                                                Style="{StaticResource PrimaryAccentButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Margin="0,4,0,0"
                                                Padding="12,7">
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                                <TextBlock Text="Add Presentation Source" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <!-- Add Source Button -->
                    <Button Grid.Column="2"
                            Command="{x:Bind ViewModel.NavigateToSourcesCommand}"
                            Padding="12,7"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="Navigate to Sources tab to queue presentation sources (Ctrl+S)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{ThemeResource AppAccentBrush}" />
                            <TextBlock Text="Add Source" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <!-- Live Control Group (Pause / Blackout) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Command="{x:Bind ViewModel.TogglePauseCommand}"
                                IsEnabled="{x:Bind ViewModel.HasActivePresentation, Mode=OneWay}"
                                Padding="12,6"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE769;" FontSize="12" Foreground="#FFA500" />
                                <TextBlock Text="{x:Bind ViewModel.PauseButtonText, Mode=OneWay}" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <Button Command="{x:Bind ViewModel.ToggleBlackoutCommand}"
                                IsEnabled="{x:Bind ViewModel.HasActivePresentation, Mode=OneWay}"
                                Padding="12,6"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE790;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.BlackoutButtonText, Mode=OneWay}" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Presenter Instruction Note -->
                    <TextBlock Grid.Column="4"
                               Text="Share the 'SwitchCast Presentation Output' window in your meeting."
                               FontSize="11"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <!-- Video Playback Controls Bar (Visible when active on-air source is a video) -->
            <Border Visibility="{x:Bind ViewModel.VideoControlsVisibility, Mode=OneWay}"
                    Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Video Status & Time Code -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Background="{ThemeResource AppBadgeBackgroundBrush}"
                                BorderBrush="{ThemeResource AppBorderBrush}"
                                BorderThickness="1"
                                Padding="6,2"
                                CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE714;" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" />
                                <TextBlock Text="VIDEO ON AIR" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource AppAccentBrush}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{x:Bind ViewModel.VideoPositionText, Mode=OneWay}"
                                   FontSize="12"
                                   FontFamily="Consolas"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Playback & Audio Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Command="{x:Bind ViewModel.ToggleVideoPlaybackCommand}"
                                Style="{StaticResource PrimaryAccentButtonStyle}"
                                Padding="12,5"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind ViewModel.VideoPlaybackButtonGlyph, Mode=OneWay}" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.VideoPlaybackButtonText, Mode=OneWay}" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <Button Command="{x:Bind ViewModel.RestartVideoCommand}"
                                Padding="12,5"
                                ToolTipService.ToolTip="Restart video from beginning"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE777;" FontSize="12" />
                                <TextBlock Text="Restart" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <Button Command="{x:Bind ViewModel.ToggleVideoLoopCommand}"
                                Padding="12,5"
                                ToolTipService.ToolTip="Toggle automatic video looping"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8EE;" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.VideoLoopButtonText, Mode=OneWay}" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <!-- Audio Divider -->
                        <Rectangle Width="1" Height="18" Fill="{ThemeResource AppSubtleDividerBrush}" Margin="2,0" VerticalAlignment="Center" />

                        <!-- Audio Mute / Unmute Button -->
                        <Button Command="{x:Bind ViewModel.ToggleMediaMuteCommand}"
                                Padding="8,5"
                                ToolTipService.ToolTip="{x:Bind ViewModel.MediaMuteButtonTooltip, Mode=OneWay}"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind ViewModel.MediaMuteButtonGlyph, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        </Button>

                        <!-- Audio Volume Slider & Percentage -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Slider Value="{x:Bind ViewModel.MediaVolume, Mode=TwoWay}"
                                    Minimum="0"
                                    Maximum="100"
                                    StepFrequency="1"
                                    SmallChange="5"
                                    LargeChange="10"
                                    Width="90"
                                    Margin="0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Media Playback Volume" />
                            <TextBlock Text="{x:Bind ViewModel.MediaVolumePercentText, Mode=OneWay}"
                                       FontSize="11"
                                       FontFamily="Consolas"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       Width="34"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Focal Live Preview Workspace -->
            <Border Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="10">
                    <!-- Preview Header Bar -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Title + Live Pill -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Preview Workspace"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            
                            <Border Visibility="{x:Bind ViewModel.LivePreviewVisibility, Mode=OneWay}"
                                    Background="#26E05353"
                                    BorderBrush="#80E05353"
                                    BorderThickness="1"
                                    Padding="8,2"
                                    CornerRadius="10">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="#E05353" />
                                    <TextBlock Text="LIVE PREVIEW" FontSize="10" FontWeight="Bold" Foreground="#FF6B6B" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Preview Actions -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- Dropdown for fast preview switching when live -->
                            <ComboBox ItemsSource="{x:Bind ViewModel.SelectedSources, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedPreviewSource, Mode=TwoWay}"
                                      PlaceholderText="Select preview source..."
                                      MinWidth="190"
                                      MaxWidth="260"
                                      Visibility="{x:Bind ViewModel.LivePreviewVisibility, Mode=OneWay}"
                                      VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:CaptureSource">
                                        <Grid ColumnSpacing="8" MaxWidth="220" ToolTipService.ToolTip="{x:Bind Title}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="{x:Bind TypeGlyph}" FontSize="12" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Title}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       MaxLines="1"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Command="{x:Bind ViewModel.StopPreviewCommand}"
                                    Style="{StaticResource DestructiveButtonStyle}"
                                    Visibility="{x:Bind ViewModel.LivePreviewVisibility, Mode=OneWay}"
                                    Padding="12,5"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE71A;" FontSize="11" />
                                    <TextBlock Text="Stop Preview" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 16:9 Aspect Video Surface Container -->
                    <Border Background="{ThemeResource AppPreviewCanvasBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="360"
                            MaxHeight="480">
                        <Grid>
                            <!-- STATE A: No sources selected -->
                            <StackPanel Visibility="{x:Bind ViewModel.EmptyWorkspaceVisibility, Mode=OneWay}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10"
                                        Padding="16,32">
                                <Border Width="48" Height="48"
                                        Background="{ThemeResource AppBadgeBackgroundBrush}"
                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="24"
                                        HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource AppTextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No presentation sources queued"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Select application windows, display monitors, or media files from the Sources tab to prepare your presentation workspace."
                                           FontSize="12"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="420" />
                                <Button Content="Add Presentation Sources"
                                        Command="{x:Bind ViewModel.NavigateToSourcesCommand}"
                                        Style="{StaticResource PrimaryAccentButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Margin="0,6,0,0">
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                                    </Button.KeyboardAccelerators>
                                </Button>
                            </StackPanel>

                            <!-- STATE B: Sources queued, Ready to Preview -->
                            <StackPanel Visibility="{x:Bind ViewModel.ReadyToPreviewVisibility, Mode=OneWay}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12"
                                        Padding="16,32">
                                <Border Width="48" Height="48"
                                        Background="{ThemeResource AppBadgeBackgroundBrush}"
                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="24"
                                        HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE714;" FontSize="20" Foreground="{ThemeResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Ready for Live Preview"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Choose a queued source and start hardware-accelerated local preview."
                                           FontSize="12"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           MaxWidth="380" />
                                
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <ComboBox ItemsSource="{x:Bind ViewModel.SelectedSources, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedPreviewSource, Mode=TwoWay}"
                                              PlaceholderText="Select source..."
                                              MinWidth="200"
                                              MaxWidth="280"
                                              VerticalAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:CaptureSource">
                                                <Grid ColumnSpacing="8" MaxWidth="240" ToolTipService.ToolTip="{x:Bind Title}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="{x:Bind TypeGlyph}" FontSize="12" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind Title}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap"
                                                               MaxLines="1"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Command="{x:Bind ViewModel.StartPreviewCommand}"
                                            Style="{StaticResource PrimaryAccentButtonStyle}"
                                            Padding="14,6"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE768;" FontSize="12" />
                                            <TextBlock Text="Start Preview" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- STATE C: Initializing Capture -->
                            <StackPanel Visibility="{x:Bind ViewModel.StartingCaptureVisibility, Mode=OneWay}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10"
                                        Padding="16,32">
                                <ProgressRing IsActive="True" Width="36" Height="36" />
                                <TextBlock Text="Initializing Direct3D frame pool..."
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Acquiring graphics capture session and GPU surface."
                                           FontSize="11"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- STATE D: Active Live Preview Stream -->
                            <Image Source="{x:Bind ViewModel.PreviewImageSource, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.LivePreviewVisibility, Mode=OneWay}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Queued Sources Mini-strip -->
            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock Text="Queued Presentation Sources"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                               VerticalAlignment="Center" />
                    <Button Content="Manage Sources"
                            Command="{x:Bind ViewModel.NavigateToSourcesCommand}"
                            HorizontalAlignment="Right"
                            Style="{ThemeResource TextBlockButtonStyle}"
                            FontSize="12" />
                </Grid>

                <!-- Empty State -->
                <Border Visibility="{x:Bind ViewModel.NoSelectedSourcesVisibility, Mode=OneWay}"
                        Padding="16"
                        Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock Text="No sources queued. Click 'Manage Sources' to add windows, displays, or media files."
                               FontSize="12"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </Border>

                <!-- Queued List -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedSources, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.HasSelectedSourcesVisibility, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:CaptureSource">
                            <Grid Padding="12,8"
                                  Margin="0,0,0,4"
                                  Background="{ThemeResource AppSurfaceBrush}"
                                  BorderBrush="{ThemeResource AppBorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0"
                                        Width="28"
                                        Height="28"
                                        Background="{ThemeResource AppBadgeBackgroundBrush}"
                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,0,10,0">
                                    <FontIcon Glyph="{x:Bind TypeGlyph}" FontSize="13" Foreground="{ThemeResource AppAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Title & Type -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{x:Bind Title}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               MaxLines="1"
                                               ToolTipService.ToolTip="{x:Bind Title}" />
                                    <TextBlock Text="{x:Bind CategoryLabel}"
                                               FontSize="10"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               MaxLines="1" />
                                </StackPanel>

                                <!-- State Indicator -->
                                <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

<Page
    x:Class="SwitchCast.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SwitchCast.Models"
    xmlns:vm="using:SwitchCast.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="32,24,32,32" MaxWidth="1000" HorizontalAlignment="Left">
            
            <!-- Header -->
            <StackPanel Spacing="6">
                <TextBlock Text="Presentation Dashboard" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Manage your presentation sources, live preview, and dedicated screen-sharing output window."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- SECTION A: PRESENTATION STATUS -->
            <Grid Padding="20"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Status Metric -->
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="PRESENTATION STATUS"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE71A;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusDisplayText, Mode=OneWay}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <!-- Active Source Metric -->
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="ACTIVE SOURCE"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveSourceTitle, Mode=OneWay}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <!-- Queued Sources Metric -->
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="QUEUED SOURCES"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedSourceCount, Mode=OneWay}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <!-- Output Window Metric -->
                <StackPanel Grid.Column="3" Spacing="4">
                    <TextBlock Text="OUTPUT WINDOW"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE78B;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.PresentationOutputStatusText, Mode=OneWay}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Error Notification -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasCaptureError, Mode=OneWay}"
                     Severity="Error"
                     Title="Capture Alert"
                     Message="{x:Bind ViewModel.CaptureErrorMessage, Mode=OneWay}"
                     IsClosable="True" />

            <!-- SECTION B: PRESENTATION OUTPUT CONTROLS (PHASE 4) -->
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Text="Dedicated Presentation Output (Share in Zoom / Teams / Meet)"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </Grid>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0: Window Management & Presentation Start/Stop -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Button Command="{x:Bind ViewModel.OpenPresentationWindowCommand}"
                                        Padding="14,8"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE78B;" FontSize="14" />
                                        <TextBlock Text="Open Output Window" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{x:Bind ViewModel.TogglePresenterDockCommand}"
                                        Padding="14,8"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Text="Floating Presenter Dock" />
                                    </StackPanel>
                                </Button>

                                <ComboBox ItemsSource="{x:Bind ViewModel.SelectedSources, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedPresentationSource, Mode=TwoWay}"
                                          DisplayMemberPath="Title"
                                          PlaceholderText="Select presentation target..."
                                          MinWidth="220"
                                          VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Command="{x:Bind ViewModel.TogglePresentationCommand}"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Padding="16,8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                                        <TextBlock Text="{x:Bind ViewModel.PresentationButtonText, Mode=OneWay}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: Active Presentation Control Strip (Pause / Blackout) -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                            <Button Command="{x:Bind ViewModel.TogglePauseCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasActivePresentation, Mode=OneWay}"
                                    Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE769;" FontSize="14" Foreground="#FFA500" />
                                    <TextBlock Text="{x:Bind ViewModel.PauseButtonText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>

                            <Button Command="{x:Bind ViewModel.ToggleBlackoutCommand}"
                                    IsEnabled="{x:Bind ViewModel.HasActivePresentation, Mode=OneWay}"
                                    Padding="14,6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE790;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.BlackoutButtonText, Mode=OneWay}" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="Select the 'SwitchCast Presentation Output' window in your video conferencing application."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- SECTION C: LOCAL LIVE PREVIEW WORKSPACE -->
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Text="Local Preview Workspace" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    
                    <!-- Live Indicator Pill (when capturing) -->
                    <Border Visibility="{x:Bind ViewModel.LivePreviewVisibility, Mode=OneWay}"
                            HorizontalAlignment="Right"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                            BorderThickness="1"
                            Padding="10,4"
                            CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                            <TextBlock Text="LIVE PREVIEW" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Workspace Container -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="24">
                    <Grid>
                        <!-- STATE A: No sources selected -->
                        <StackPanel Visibility="{x:Bind ViewModel.EmptyWorkspaceVisibility, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="12"
                                    Padding="16,32">
                            <FontIcon Glyph="&#xE790;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="No presentation sources queued"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       FontSize="16"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Select application windows or display monitors from the Sources page to initialize live preview."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="420" />
                            <Button Content="Manage Presentation Sources"
                                    Command="{x:Bind ViewModel.NavigateToSourcesCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,0">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                                </Button.KeyboardAccelerators>
                            </Button>
                        </StackPanel>

                        <!-- STATE B: Sources queued, Ready to Start Preview -->
                        <StackPanel Visibility="{x:Bind ViewModel.ReadyToPreviewVisibility, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="16"
                                    Padding="16,32">
                            <FontIcon Glyph="&#xE714;" FontSize="40" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Ready for Live Preview"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       FontSize="16"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Choose a queued presentation source and start hardware-accelerated preview."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="420" />
                            
                            <!-- Source Selector & Action -->
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <ComboBox ItemsSource="{x:Bind ViewModel.SelectedSources, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedPreviewSource, Mode=TwoWay}"
                                          DisplayMemberPath="Title"
                                          PlaceholderText="Select presentation source..."
                                          MinWidth="240"
                                          VerticalAlignment="Center" />
                                <Button Command="{x:Bind ViewModel.StartPreviewCommand}"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Padding="16,8"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                                        <TextBlock Text="Start Live Preview" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- STATE C: Initializing / Starting -->
                        <StackPanel Visibility="{x:Bind ViewModel.StartingCaptureVisibility, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="14"
                                    Padding="16,40">
                            <ProgressRing IsActive="True" Width="40" Height="40" />
                            <TextBlock Text="Initializing capture session &amp; Direct3D frame pool..."
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Acquiring graphics item and establishing GPU surface pipeline."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- STATE D: Active Live Preview Stream -->
                        <Grid Visibility="{x:Bind ViewModel.LivePreviewVisibility, Mode=OneWay}" RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Preview Toolbar -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Source Switcher -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="Previewing:" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{x:Bind ViewModel.SelectedSources, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedPreviewSource, Mode=TwoWay}"
                                              DisplayMemberPath="Title"
                                              MinWidth="220"
                                              VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Stop Button -->
                                <Button Grid.Column="1"
                                        Command="{x:Bind ViewModel.StopPreviewCommand}"
                                        VerticalAlignment="Center"
                                        Padding="14,6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE71A;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <TextBlock Text="Stop Preview" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Live Video Surface -->
                            <Border Grid.Row="1"
                                    Background="#0A0A0A"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MinHeight="360"
                                    MaxHeight="500">
                                <Image Source="{x:Bind ViewModel.PreviewImageSource, Mode=OneWay}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- SECTION D: QUICK ACTIONS -->
            <StackPanel Spacing="12">
                <TextBlock Text="Presenter Quick Actions" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Padding="12,16"
                            Command="{x:Bind ViewModel.NavigateToSourcesCommand}">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE710;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="Manage Sources" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="Configure queue" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Padding="12,16"
                            Command="{x:Bind ViewModel.TogglePresentationCommand}">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE768;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.PresentationButtonText, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="Dedicated output" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Padding="12,16"
                            Command="{x:Bind ViewModel.TogglePauseCommand}"
                            IsEnabled="{x:Bind ViewModel.HasActivePresentation, Mode=OneWay}">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE769;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.PauseButtonText, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="Freeze output frame" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3"
                            HorizontalAlignment="Stretch"
                            Padding="12,16"
                            Command="{x:Bind ViewModel.ToggleBlackoutCommand}"
                            IsEnabled="{x:Bind ViewModel.HasActivePresentation, Mode=OneWay}">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE790;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.BlackoutButtonText, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="Solid black screen" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- SECTION E: SELECTED SOURCES OVERVIEW -->
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Text="Queued Presentation Sources" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="Manage Sources"
                            Command="{x:Bind ViewModel.NavigateToSourcesCommand}"
                            HorizontalAlignment="Right"
                            Style="{ThemeResource TextBlockButtonStyle}" />
                </Grid>

                <!-- Empty State (when 0 items queued) -->
                <Border Visibility="{x:Bind ViewModel.NoSelectedSourcesVisibility, Mode=OneWay}"
                        Padding="24"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" Spacing="8" Padding="12">
                        <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No Sources Queued" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Navigate to the Sources tab to discover running applications and connected displays."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Queued Sources List (when items are selected) -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedSources, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.HasSelectedSourcesVisibility, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:CaptureSource">
                            <Grid Padding="16,12"
                                  Margin="0,0,0,8"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="1"
                                  CornerRadius="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,0,12,0">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Title & Type -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                    <TextBlock Text="{x:Bind Id}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                </StackPanel>

                                <!-- Status Badge -->
                                <Border Grid.Column="2"
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        Padding="8,4"
                                        CornerRadius="4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Ready to Present" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

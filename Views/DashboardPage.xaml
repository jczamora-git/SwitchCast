<Page
    x:Class="SwitchCast.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SwitchCast.Models"
    xmlns:vm="using:SwitchCast.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="32,24,32,32" MaxWidth="1000" HorizontalAlignment="Left">
            
            <!-- Header -->
            <StackPanel Spacing="6">
                <TextBlock Text="Presentation Dashboard" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="Manage your presentation sources and screen-sharing workspace."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- SECTION A: PRESENTATION STATUS -->
            <Grid Padding="20"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Status Metric -->
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="PRESENTATION STATUS"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE71A;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.StatusDisplayText, Mode=OneWay}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <!-- Active Source Metric -->
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="ACTIVE SOURCE"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ActiveSourceTitle, Mode=OneWay}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <!-- Selected Count Metric -->
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="QUEUED SOURCES"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedSourceCount, Mode=OneWay}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- SECTION B: PRESENTATION WORKSPACE -->
            <StackPanel Spacing="12">
                <TextBlock Text="Presentation Workspace" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />

                <Border Padding="40,48"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        MinHeight="220">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <FontIcon Glyph="&#xE790;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No presentation source selected"
                                   Style="{ThemeResource BodyStrongTextBlockStyle}"
                                   FontSize="16"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Add application windows or displays to prepare your presentation workspace."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   MaxWidth="400" />
                        <Button Content="Manage Presentation Sources"
                                Command="{x:Bind ViewModel.NavigateToSourcesCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="S" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- SECTION C: QUICK ACTIONS -->
            <StackPanel Spacing="12">
                <TextBlock Text="Presenter Quick Actions" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Padding="12,16"
                            Command="{x:Bind ViewModel.NavigateToSourcesCommand}">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE710;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="Manage Sources" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="Configure list" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Padding="12,16"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Starts the Direct3D 11 presentation output window (Implemented in Phase 4).">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE768;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="Start Presenting" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="Phase 4" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Padding="12,16"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Freezes output frame during transitions (Implemented in Phase 5).">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE769;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="Pause Stream" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="Phase 5" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3"
                            HorizontalAlignment="Stretch"
                            Padding="12,16"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Instantly outputs a black screen (Implemented in Phase 5).">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE790;" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="Blackout" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="Phase 5" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- SECTION D: SELECTED SOURCES OVERVIEW -->
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Text="Queued Presentation Sources" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="Manage Sources"
                            Command="{x:Bind ViewModel.NavigateToSourcesCommand}"
                            HorizontalAlignment="Right"
                            Style="{ThemeResource TextBlockButtonStyle}" />
                </Grid>

                <!-- Empty State (when 0 items queued) -->
                <Border Visibility="{x:Bind ViewModel.NoSelectedSourcesVisibility, Mode=OneWay}"
                        Padding="24"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel HorizontalAlignment="Center" Spacing="8" Padding="12">
                        <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No Sources Queued" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Navigate to the Sources tab to discover running applications and connected displays."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Queued Sources List (when items are selected) -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedSources, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.HasSelectedSourcesVisibility, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:CaptureSource">
                            <Grid Padding="16,12"
                                  Margin="0,0,0,8"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="1"
                                  CornerRadius="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,0,12,0">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Title & Type -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                    <TextBlock Text="{x:Bind Id}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                </StackPanel>

                                <!-- Status Badge -->
                                <Border Grid.Column="2"
                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                        Padding="8,4"
                                        CornerRadius="4"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Ready to Present" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>

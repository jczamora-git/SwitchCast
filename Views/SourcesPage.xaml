<Page
    x:Class="SwitchCast.Views.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SwitchCast.ViewModels"
    mc:Ignorable="d"
    Loaded="OnPageLoaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Padding="32,24,32,32" MaxWidth="1000" HorizontalAlignment="Left">
            
            <!-- Header & Actions -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Presentation Sources" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="SemiBold" />
                    <TextBlock Text="Select the application windows and displays you want to use during your presentation."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Refresh Button -->
                <Button Grid.Column="1"
                        Command="{x:Bind ViewModel.RefreshSourcesCommand}"
                        VerticalAlignment="Center"
                        Padding="16,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh Sources" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Error Notification -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Severity="Error"
                     Title="Discovery Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     IsClosable="True" />

            <!-- Filter and Category Selector -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Category Selector -->
                <RadioButtons Grid.Column="0"
                              SelectedIndex="{x:Bind ViewModel.SelectedCategoryIndex, Mode=TwoWay}"
                              MaxColumns="2"
                              VerticalAlignment="Center">
                    <RadioButton Content="{x:Bind ViewModel.WindowCategoryHeader, Mode=OneWay}" Margin="0,0,16,0" />
                    <RadioButton Content="{x:Bind ViewModel.DisplayCategoryHeader, Mode=OneWay}" />
                </RadioButtons>

                <!-- Search Box -->
                <TextBox Grid.Column="1"
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Filter by title or process name..."
                         HorizontalAlignment="Right"
                         Width="280"
                         VerticalAlignment="Center" />
            </Grid>

            <!-- Loading Indicator -->
            <StackPanel Visibility="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"
                        Spacing="12"
                        HorizontalAlignment="Center"
                        Margin="0,32,0,32">
                <ProgressRing IsActive="True" Width="36" Height="36" />
                <TextBlock Text="Scanning active application windows and display monitors..."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Empty State -->
            <Border Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                    Padding="48,56"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    MinHeight="260">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="440">
                    <FontIcon Glyph="&#xE7F4;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyStateSubtitle, Mode=OneWay}"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <Button Content="Scan Again"
                            Command="{x:Bind ViewModel.RefreshSourcesCommand}"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Discovered Sources List -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.DisplayedSources, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SelectableSourceItem">
                        <Grid Padding="16,14"
                              Margin="0,0,0,8"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              CornerRadius="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Type Icon -->
                            <Border Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,16,0">
                                <FontIcon Glyph="{x:Bind TypeGlyph}" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Title & Metadata -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
                                <TextBlock Text="{x:Bind Title}"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                                <TextBlock Text="{x:Bind Subtitle}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                            </StackPanel>

                            <!-- Unavailable Badge -->
                            <Border Grid.Column="2"
                                    Visibility="{x:Bind UnavailableBadgeVisibility, Mode=OneWay}"
                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    Padding="8,4"
                                    CornerRadius="4"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Closed / Unavailable" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontWeight="SemiBold" />
                            </Border>

                            <!-- Selection Checkbox -->
                            <CheckBox Grid.Column="3"
                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                      Content="Queue"
                                      IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Selection Queue Summary Footer -->
            <Grid Padding="20"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="SELECTED PRESENTATION QUEUE"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.SelectedSourceCount, Mode=OneWay}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}"
                                   FontWeight="Bold" />
                        <TextBlock Text="sources queued for presentation"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="SwitchCast will let you switch between queued items using hotkeys."
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>

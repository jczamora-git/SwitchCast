<Page
    x:Class="SwitchCast.Views.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SwitchCast.ViewModels"
    mc:Ignorable="d"
    Loaded="OnPageLoaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="28,20,28,28" MaxWidth="1040" HorizontalAlignment="Left">
            
            <!-- Header & Actions -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="Sources"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    <TextBlock Text="Select application windows, displays, and media files to include in your presentation."
                               FontSize="12"
                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                </StackPanel>

                <!-- Actions Header Strip -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- Add Media Button (visible when Media Files selected) -->
                    <Button Command="{x:Bind ViewModel.AddMediaCommand}"
                            Visibility="{x:Bind ViewModel.IsMediaCategorySelected, Mode=OneWay}"
                            Style="{StaticResource PrimaryAccentButtonStyle}"
                            VerticalAlignment="Center"
                            Padding="14,6"
                            ToolTipService.ToolTip="Import local images (PNG, JPG, BMP) and videos (MP4, WMV)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                            <TextBlock Text="Add Media" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <!-- Refresh Button -->
                    <Button Command="{x:Bind ViewModel.RefreshSourcesCommand}"
                            VerticalAlignment="Center"
                            Padding="14,6"
                            ToolTipService.ToolTip="Rescan running windows and connected monitors">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            <TextBlock Text="Refresh" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Error Notification -->
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Severity="Error"
                     Title="Discovery Error"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     IsClosable="True" />

            <!-- Unified Filter & Search Toolbar -->
            <Border Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Category Selector (Windows / Displays / Media Files) -->
                    <RadioButtons Grid.Column="0"
                                  SelectedIndex="{x:Bind ViewModel.SelectedCategoryIndex, Mode=TwoWay}"
                                  MaxColumns="3"
                                  VerticalAlignment="Center">
                        <RadioButton Content="{x:Bind ViewModel.WindowCategoryHeader, Mode=OneWay}"
                                     FontSize="12"
                                     Margin="0,0,14,0" />
                        <RadioButton Content="{x:Bind ViewModel.DisplayCategoryHeader, Mode=OneWay}"
                                     FontSize="12"
                                     Margin="0,0,14,0" />
                        <RadioButton Content="{x:Bind ViewModel.MediaCategoryHeader, Mode=OneWay}"
                                     FontSize="12" />
                    </RadioButtons>

                    <!-- Search Input -->
                    <TextBox Grid.Column="2"
                             Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Filter by title, process, or filename..."
                             Width="260"
                             FontSize="12"
                             VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Loading Indicator -->
            <StackPanel Visibility="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"
                        Spacing="10"
                        HorizontalAlignment="Center"
                        Margin="0,28">
                <ProgressRing IsActive="True" Width="32" Height="32" />
                <TextBlock Text="Scanning active presentation sources..."
                           FontSize="12"
                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
            </StackPanel>

            <!-- Empty State -->
            <Border Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                    Padding="36,40"
                    Background="{ThemeResource AppSurfaceBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="420">
                    <Border Width="48" Height="48"
                            Background="{ThemeResource AppBadgeBackgroundBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="24"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE7F4;" FontSize="20" Foreground="{ThemeResource AppTextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyStateSubtitle, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Button Content="Add Media"
                                Command="{x:Bind ViewModel.AddMediaCommand}"
                                Visibility="{x:Bind ViewModel.IsMediaCategorySelected, Mode=OneWay}"
                                Style="{StaticResource PrimaryAccentButtonStyle}" />
                        <Button Content="Scan Again"
                                Command="{x:Bind ViewModel.RefreshSourcesCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Compact Discovered Sources List -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.DisplayedSources, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SelectableSourceItem">
                        <Grid Padding="12,8"
                              Margin="0,0,0,4"
                              Background="{ThemeResource AppSurfaceBrush}"
                              BorderBrush="{ThemeResource AppBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Type Glyph Tile / Real Application Icon -->
                            <Border Grid.Column="0"
                                    Width="32"
                                    Height="32"
                                    Background="{ThemeResource AppBadgeBackgroundBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,0,12,0">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Real Native Application Icon -->
                                    <Image Source="{x:Bind IconSource, Mode=OneWay}"
                                           Width="20"
                                           Height="20"
                                           Stretch="Uniform"
                                           Visibility="{x:Bind HasIconSource, Mode=OneWay}" />

                                    <!-- Fallback Glyph Icon -->
                                    <FontIcon Glyph="{x:Bind TypeGlyph}"
                                              FontSize="13"
                                              Foreground="{ThemeResource AppAccentBrush}"
                                              Visibility="{x:Bind HasNoIconSource, Mode=OneWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Title & Metadata -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="0,0,12,0">
                                <TextBlock Text="{x:Bind Title}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           MaxLines="1"
                                           ToolTipService.ToolTip="{x:Bind Title}" />
                                <TextBlock Text="{x:Bind Subtitle}"
                                           FontSize="11"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           MaxLines="1"
                                           ToolTipService.ToolTip="{x:Bind Subtitle}" />
                            </StackPanel>

                            <!-- Unavailable Badge -->
                            <Border Grid.Column="2"
                                    Visibility="{x:Bind UnavailableBadgeVisibility, Mode=OneWay}"
                                    Background="{ThemeResource AppBadgeBackgroundBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    BorderThickness="1"
                                    Padding="6,2"
                                    CornerRadius="4"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Unavailable" FontSize="10" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontWeight="SemiBold" />
                            </Border>

                            <!-- Remove Button (Media files only) -->
                            <Button Grid.Column="3"
                                    Click="OnRemoveMediaClicked"
                                    Visibility="{x:Bind RemoveButtonVisibility, Mode=OneWay}"
                                    Style="{ThemeResource SubtleButtonStyle}"
                                    Padding="6,4"
                                    Margin="0,0,8,0"
                                    ToolTipService.ToolTip="Remove from media library"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource AppTextTertiaryBrush}" />
                            </Button>

                            <!-- Selection Checkbox -->
                            <CheckBox Grid.Column="4"
                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                      Content="Queue"
                                      FontSize="12"
                                      IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Selection Queue Summary Footer -->
            <Grid Padding="14,10"
                  Background="{ThemeResource AppSurfaceBrush}"
                  BorderBrush="{ThemeResource AppBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="13" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedSourceCount, Mode=OneWay}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{ThemeResource AppTextPrimaryBrush}" />
                    <TextBlock Text="sources in presentation queue"
                               FontSize="12"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="Switch sources via hotkeys (Ctrl+Shift+Right/Left) or Presenter Dock."
                           FontSize="11"
                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>

<Page
    x:Class="SwitchCast.Views.MusicLibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:music="using:SwitchCast.Models.Music"
    xmlns:vm="using:SwitchCast.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid HorizontalAlignment="Stretch">
            <StackPanel Spacing="16" Padding="28,20,28,28" MaxWidth="1160" HorizontalAlignment="Stretch">

                <!-- Header & Actions -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="3">
                        <TextBlock Text="Music &amp; Playlists"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        <TextBlock Text="Manage background music for your presentations."
                                   FontSize="12"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Primary Actions Strip -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Command="{x:Bind ViewModel.CreatePlaylistCommand}"
                                Padding="12,6"
                                ToolTipService.ToolTip="Create a new playlist">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                <TextBlock Text="New Playlist" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <Button Command="{x:Bind ViewModel.ImportAudioCommand}"
                                Style="{StaticResource PrimaryAccentButtonStyle}"
                                Padding="14,6"
                                ToolTipService.ToolTip="Import local audio files (.mp3, .wav, .m4a, .aac, .wma)">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8D6;" FontSize="13" />
                                <TextBlock Text="Import Audio" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Feedback InfoBar -->
                <InfoBar IsOpen="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay}"
                         Severity="Informational"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         IsClosable="True" />

                <!-- Main Content Area: Left (Playlists) & Right (Tracks) -->
                <Grid ColumnSpacing="16" MinHeight="380">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Playlist Navigation Panel -->
                    <Border Grid.Column="0"
                            Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                            <!-- Playlists Header -->
                            <Grid Grid.Row="0" Margin="4,2,4,4">
                                <TextBlock Text="PLAYLISTS"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextTertiaryBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.PlaylistsCountText, Mode=OneWay}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AppTextTertiaryBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- Playlists List -->
                            <ListView Grid.Row="1"
                                      ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedPlaylist, Mode=TwoWay}"
                                      SelectionMode="Single"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="music:MusicPlaylist">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="2,4">
                                            <FontIcon Grid.Column="0" Glyph="&#xE8D6;" FontSize="13" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" />
                                                <TextBlock Text="{x:Bind Tracks.Count, Mode=OneWay}"
                                                           FontSize="10"
                                                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Bottom Quick Action -->
                            <Button Grid.Row="2"
                                    Command="{x:Bind ViewModel.CreatePlaylistCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Padding="8,6">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" />
                                    <TextBlock Text="Add Playlist" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Right: Selected Playlist Contents -->
                    <Border Grid.Column="1"
                            Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid RowDefinitions="Auto,*" RowSpacing="12">
                            <!-- Playlist Header Strip -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedPlaylist.Name, Mode=OneWay, FallbackValue='No Playlist Selected'}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                        <Border Visibility="{x:Bind ViewModel.ActivePlaylistBadgeVisibility, Mode=OneWay}"
                                                Background="#2634D399"
                                                BorderBrush="#4D34D399"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,1"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="ON AIR PLAYLIST" FontSize="9" FontWeight="SemiBold" Foreground="#34D399" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedPlaylistTracksCountText, Mode=OneWay, FallbackValue='0 tracks'}"
                                               FontSize="11"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </StackPanel>

                                <!-- Playlist Actions -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Command="{x:Bind ViewModel.SetActivePlaylistCommand}"
                                            CommandParameter="{x:Bind ViewModel.SelectedPlaylist, Mode=OneWay}"
                                            Padding="10,5"
                                            ToolTipService.ToolTip="Set this playlist as the active audio source for presentations">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.ActivePlaylistBadgeText, Mode=OneWay}" FontSize="11" />
                                        </StackPanel>
                                    </Button>

                                    <Button Click="OnRenamePlaylistClick"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Padding="6,5"
                                            ToolTipService.ToolTip="Rename this playlist">
                                        <FontIcon Glyph="&#xE8AC;" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                    </Button>

                                    <Button Command="{x:Bind ViewModel.DeletePlaylistCommand}"
                                            CommandParameter="{x:Bind ViewModel.SelectedPlaylist, Mode=OneWay}"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Padding="6,5"
                                            ToolTipService.ToolTip="Delete this playlist (does not delete audio files)">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#FF6B6B" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Track List or Empty State -->
                            <Grid Grid.Row="1">
                                <!-- Empty State -->
                                <Border Visibility="{x:Bind ViewModel.EmptyPlaylistVisibility, Mode=OneWay}"
                                        Background="{ThemeResource AppBackgroundBrush}"
                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="24"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                        <FontIcon Glyph="&#xE8D6;" FontSize="32" Foreground="{ThemeResource AppTextTertiaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="No tracks in this playlist"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Import MP3, WAV, M4A, or WMA files to build your background audio library."
                                                   FontSize="12"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                   HorizontalAlignment="Center" />
                                        <Button Command="{x:Bind ViewModel.ImportAudioCommand}"
                                                Style="{StaticResource PrimaryAccentButtonStyle}"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Center"
                                                Padding="16,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8D6;" FontSize="12" />
                                                <TextBlock Text="Import Audio" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Tracks ListView -->
                                <ListView Visibility="{x:Bind ViewModel.PlaylistTracksVisibility, Mode=OneWay}"
                                          ItemsSource="{x:Bind ViewModel.SelectedPlaylistTracks, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedTrack, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="music:MusicTrack">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                                  ColumnSpacing="10"
                                                  Padding="4,6">
                                                <!-- Play Button -->
                                                <Button Grid.Column="0"
                                                        Click="OnPlayTrackClick"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        Padding="4,2"
                                                        ToolTipService.ToolTip="Play this track">
                                                    <FontIcon Glyph="&#xE768;" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" />
                                                </Button>

                                                <!-- Title and Artist -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                    <TextBlock Text="{x:Bind Artist, Mode=OneWay, FallbackValue='Local Audio'}"
                                                               FontSize="10"
                                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                </StackPanel>

                                                <!-- Missing Indicator -->
                                                <Border Grid.Column="2"
                                                        Visibility="{x:Bind MissingBadgeVisibility, Mode=OneWay}"
                                                        Background="#33FF0000"
                                                        Padding="4,1"
                                                        CornerRadius="3"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="Missing File" FontSize="9" Foreground="#FFFF6B6B" />
                                                </Border>

                                                <!-- Duration -->
                                                <TextBlock Grid.Column="3"
                                                            Text="{x:Bind FormattedDuration, Mode=OneWay}"
                                                            FontSize="11"
                                                            FontFamily="Consolas"
                                                            Foreground="{ThemeResource AppTextTertiaryBrush}"
                                                            VerticalAlignment="Center" />

                                                <!-- Reorder & Remove Actions -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                    <Button Click="OnMoveTrackUpClick"
                                                            Style="{StaticResource SubtleButtonStyle}"
                                                            Padding="4,3"
                                                            ToolTipService.ToolTip="Move track up">
                                                        <FontIcon Glyph="&#xE74A;" FontSize="10" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                    </Button>
                                                    <Button Click="OnMoveTrackDownClick"
                                                            Style="{StaticResource SubtleButtonStyle}"
                                                            Padding="4,3"
                                                            ToolTipService.ToolTip="Move track down">
                                                        <FontIcon Glyph="&#xE74B;" FontSize="10" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                    </Button>
                                                    <Button Click="OnRemoveTrackClick"
                                                            Style="{StaticResource SubtleButtonStyle}"
                                                            Padding="4,3"
                                                            ToolTipService.ToolTip="Remove track from playlist">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="10" Foreground="#FF6B6B" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Bottom Now Playing Strip -->
                <Border Background="{ThemeResource AppSurfaceElevatedBrush}"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                        <!-- Upper Strip: Track Info, Seek Slider, Volume -->
                        <Grid Grid.Row="0" ColumnDefinitions="260,*,220" ColumnSpacing="16">
                            <!-- Track Info -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="13" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.CurrentTrackTitle, Mode=OneWay}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.CurrentTrackTitle, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.CurrentTrackArtist, Mode=OneWay}"
                                           FontSize="10"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           Margin="19,0,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                            </StackPanel>

                            <!-- Seek Slider & Position Text -->
                            <Grid Grid.Column="1" VerticalAlignment="Center" RowDefinitions="Auto,Auto">
                                <Slider Grid.Row="0"
                                        Minimum="0"
                                        Maximum="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}"
                                        Value="{x:Bind ViewModel.PositionSeconds, Mode=TwoWay}"
                                        StepFrequency="1"
                                        Padding="0"
                                        Margin="0"
                                        PointerCaptureLost="OnSeekSliderPointerCaptureLost" />
                                <TextBlock Grid.Row="1"
                                           Text="{x:Bind ViewModel.PositionText, Mode=OneWay}"
                                           FontSize="10"
                                           FontFamily="Consolas"
                                           Foreground="{ThemeResource AppTextTertiaryBrush}"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Volume & Mute -->
                            <Grid Grid.Column="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                <Slider Grid.Column="0"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                                        StepFrequency="1"
                                        Padding="0"
                                        Margin="0" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ViewModel.VolumePercentText, Mode=OneWay}"
                                           FontSize="10"
                                           FontFamily="Consolas"
                                           Foreground="{ThemeResource AppTextTertiaryBrush}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="2"
                                        Command="{x:Bind ViewModel.ToggleMuteCommand}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Padding="6,4"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.MuteTooltip, Mode=OneWay}"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind ViewModel.MuteGlyph, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AppAccentBrush}" />
                                </Button>
                            </Grid>
                        </Grid>

                        <!-- Lower Strip: Transport Controls -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                            <!-- Shuffle -->
                            <Button Command="{x:Bind ViewModel.ToggleShuffleCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Padding="8,4"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.ShuffleTooltip, Mode=OneWay}">
                                <FontIcon Glyph="&#xE8B1;" FontSize="12"
                                          Opacity="{x:Bind ViewModel.ShuffleOpacity, Mode=OneWay}"
                                          Foreground="{ThemeResource AppAccentBrush}" />
                            </Button>

                            <!-- Previous -->
                            <Button Command="{x:Bind ViewModel.PreviousTrackCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Padding="8,4"
                                    ToolTipService.ToolTip="Previous Track">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            </Button>

                            <!-- Play / Pause -->
                            <Button Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Padding="10,4"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.PlayPauseTooltip, Mode=OneWay}">
                                <FontIcon Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" FontSize="15" Foreground="{ThemeResource AppAccentBrush}" />
                            </Button>

                            <!-- Stop -->
                            <Button Command="{x:Bind ViewModel.StopCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Padding="8,4"
                                    ToolTipService.ToolTip="Stop Playback">
                                <FontIcon Glyph="&#xE71A;" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            </Button>

                            <!-- Next -->
                            <Button Command="{x:Bind ViewModel.NextTrackCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Padding="8,4"
                                    ToolTipService.ToolTip="Next Track">
                                <FontIcon Glyph="&#xE76C;" FontSize="12" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            </Button>

                            <!-- Repeat -->
                            <Button Command="{x:Bind ViewModel.CycleRepeatModeCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Padding="8,4"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.RepeatTooltip, Mode=OneWay}">
                                <FontIcon Glyph="{x:Bind ViewModel.RepeatGlyph, Mode=OneWay}" FontSize="12"
                                          Opacity="{x:Bind ViewModel.RepeatOpacity, Mode=OneWay}"
                                          Foreground="{ThemeResource AppAccentBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

<Page
    x:Class="SwitchCast.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SwitchCast.Models"
    xmlns:diagModels="using:SwitchCast.Models.Diagnostics"
    xmlns:vm="using:SwitchCast.ViewModels"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="28,20,28,28" MaxWidth="1080" HorizontalAlignment="Stretch">
            
            <!-- Page Header -->
            <StackPanel Spacing="3">
                <TextBlock Text="Settings"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                <TextBlock Text="Preferences, appearance, window options, and global presenter shortcuts."
                           FontSize="12"
                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
            </StackPanel>

            <!-- Two-Pane Settings Layout -->
            <Grid ColumnSpacing="20" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <!-- Category Navigation Pane (190 DIP) -->
                    <ColumnDefinition Width="190" />
                    <!-- Settings Content Pane (Flexible) -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Category Navigation Sidebar -->
                <Border Grid.Column="0"
                        Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="6,6"
                        VerticalAlignment="Top">
                    <ListView SelectedIndex="{x:Bind ViewModel.SelectedCategoryIndex, Mode=TwoWay}"
                              SelectionMode="Single"
                              IsItemClickEnabled="False"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="36" />
                                <Setter Property="Height" Value="38" />
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <!-- 0: General -->
                        <ListViewItem>
                            <Grid ColumnSpacing="10" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="General" FontSize="12" FontWeight="Normal" VerticalAlignment="Center" />
                            </Grid>
                        </ListViewItem>

                        <!-- 1: Appearance -->
                        <ListViewItem>
                            <Grid ColumnSpacing="10" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="14" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Appearance" FontSize="12" FontWeight="Normal" VerticalAlignment="Center" />
                            </Grid>
                        </ListViewItem>

                        <!-- 2: Window -->
                        <ListViewItem>
                            <Grid ColumnSpacing="10" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE78B;" FontSize="14" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Window" FontSize="12" FontWeight="Normal" VerticalAlignment="Center" />
                            </Grid>
                        </ListViewItem>

                        <!-- 3: Presenter -->
                        <ListViewItem>
                            <Grid ColumnSpacing="10" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="14" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Presenter" FontSize="12" FontWeight="Normal" VerticalAlignment="Center" />
                            </Grid>
                        </ListViewItem>

                        <!-- 4: Shortcuts -->
                        <ListViewItem>
                            <Grid ColumnSpacing="10" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE765;" FontSize="14" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Shortcuts" FontSize="12" FontWeight="Normal" VerticalAlignment="Center" />
                            </Grid>
                        </ListViewItem>

                        <!-- 5: Diagnostics & Reports -->
                        <ListViewItem>
                            <Grid ColumnSpacing="10" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE9D9;" FontSize="14" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Diagnostics &amp; Reports" FontSize="12" FontWeight="Normal" VerticalAlignment="Center" />
                            </Grid>
                        </ListViewItem>
                    </ListView>
                </Border>

                <!-- Settings Content Panel -->
                <StackPanel Grid.Column="1" Spacing="16">
                    
                    <!-- ========================================================= -->
                    <!-- CATEGORY 0: GENERAL & ABOUT                               -->
                    <!-- ========================================================= -->
                    <Border Visibility="{x:Bind ViewModel.GeneralCategoryVisibility, Mode=OneWay}"
                            Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="General &amp; About"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />

                            <!-- App Identity Strip -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="44"
                                        Height="44"
                                        Background="{ThemeResource AppAccentBrush}"
                                        CornerRadius="8"
                                        Margin="0,0,14,0">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="20" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.AppName, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                        <Border Background="{ThemeResource AppBadgeBackgroundBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" Padding="6,2" CornerRadius="4">
                                            <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppAccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.AppSubtitle, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Description (with text wrapping to prevent clipping) -->
                            <TextBlock Text="{x:Bind ViewModel.AppDescription, Mode=OneWay}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       LineHeight="16"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}" />

                            <Rectangle Height="1" Fill="{ThemeResource AppSubtleDividerBrush}" />

                            <!-- Application & Creator Metadata Table -->
                            <Grid RowSpacing="10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Creator Attribution -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Creator" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Creator, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" VerticalAlignment="Center" />

                                <!-- Built With -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Built With" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.BuiltWith, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppTextPrimaryBrush}" VerticalAlignment="Center" />

                                <!-- Platform & Target -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Operating System" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.PlatformDescription, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppTextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />

                                <!-- Repository Link -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Repository" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                <Button Grid.Row="3" Grid.Column="1"
                                        Command="{x:Bind ViewModel.OpenRepositoryCommand}"
                                        Style="{ThemeResource SubtleButtonStyle}"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE71B;" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" />
                                        <TextBlock Text="github.com/jczamora-git/SwitchCast" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" TextDecorations="Underline" />
                                    </StackPanel>
                                </Button>

                                <!-- Privacy Architecture -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Privacy Architecture" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.PrivacyStatement, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.PrivacyDetails, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ========================================================= -->
                    <!-- CATEGORY 1: APPEARANCE & THEME                            -->
                    <!-- ========================================================= -->
                    <Border Visibility="{x:Bind ViewModel.AppearanceCategoryVisibility, Mode=OneWay}"
                            Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Appearance &amp; Theme"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />

                            <!-- Row: App Theme -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="App Theme" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="Choose the application's color mode."
                                               FontSize="11"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <ComboBox Grid.Column="1"
                                          SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                                          MinWidth="140"
                                          Height="34"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="System" />
                                    <ComboBoxItem Content="Light" />
                                    <ComboBoxItem Content="Dark" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ========================================================= -->
                    <!-- CATEGORY 2: WINDOW PREFERENCES                            -->
                    <!-- ========================================================= -->
                    <Border Visibility="{x:Bind ViewModel.WindowCategoryVisibility, Mode=OneWay}"
                            Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Window Preferences"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />

                            <!-- Row: Remember Dimensions -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Remember Window Dimensions" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="Automatically save and restore main window dimensions and position on startup."
                                               FontSize="11"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.RememberWindowDimensions, Mode=TwoWay}"
                                              OnContent="Enabled"
                                              OffContent="Disabled"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ========================================================= -->
                    <!-- CATEGORY 3: PRESENTER CONTROLS                            -->
                    <!-- ========================================================= -->
                    <Border Visibility="{x:Bind ViewModel.PresenterCategoryVisibility, Mode=OneWay}"
                            Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Presenter Controls &amp; Dock"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />

                            <!-- Row 1: Enable Global Hotkeys -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Enable Global Hotkeys" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="Switch sources and control live stream from anywhere in Windows."
                                               FontSize="11"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.EnableGlobalHotkeys, Mode=TwoWay}"
                                              OnContent="Enabled"
                                              OffContent="Disabled"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource AppSubtleDividerBrush}" />

                            <!-- Row 2: Auto-Open Floating Presenter Dock -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Auto-Open Presenter Dock" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="Automatically display the floating dock when starting a live presentation."
                                               FontSize="11"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.AutoOpenPresenterDock, Mode=TwoWay}"
                                              OnContent="Enabled"
                                              OffContent="Disabled"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource AppSubtleDividerBrush}" />

                            <!-- Row 3: Keep Presenter Dock Always on Top -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Dock Always on Top" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="Keep the presenter dock pinned above full-screen windows and browser tabs."
                                               FontSize="11"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.DockAlwaysOnTop, Mode=TwoWay}"
                                              OnContent="Enabled"
                                              OffContent="Disabled"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource AppSubtleDividerBrush}" />

                            <!-- Row 4: Default Source Switching Mode -->
                            <StackPanel Spacing="6" Margin="0,2">
                                <TextBlock Text="Source Switching Mode" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock Text="Configure window focus and output switching behavior during presentation."
                                           FontSize="11"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}" />

                                <RadioButtons SelectedIndex="{x:Bind ViewModel.SelectedSwitchModeIndex, Mode=TwoWay}" Margin="0,4,0,0">
                                    <RadioButton Content="Active + Live (A+L) — Focus application and switch live output stream" Tag="0" FontSize="11" Margin="0,0,0,2" />
                                    <RadioButton Content="Active Only (A) — Focus application window without altering output stream" Tag="1" FontSize="11" Margin="0,0,0,2" />
                                    <RadioButton Content="Live Only (L) — Switch live output stream without activating application window" Tag="2" FontSize="11" />
                                </RadioButtons>
                            </StackPanel>

                            <Rectangle Height="1" Fill="{ThemeResource AppSubtleDividerBrush}" />

                            <!-- Row 5: Auto-Detect External Display -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Auto-Detect External Display" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="Automatically detect connected TVs or projectors and direct Presentation Output to them."
                                               FontSize="11"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.AutoDetectExternalDisplay, Mode=TwoWay}"
                                              OnContent="Enabled"
                                              OffContent="Disabled"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource AppSubtleDividerBrush}" />

                            <!-- Row 6: Auto-Fullscreen on External Display -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Automatically Fullscreen on External Display" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="Enter fullscreen presentation mode automatically when directed to an external display."
                                               FontSize="11"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <ToggleSwitch Grid.Column="1"
                                              IsOn="{x:Bind ViewModel.AutoFullscreenOnExternalDisplay, Mode=TwoWay}"
                                              IsEnabled="{x:Bind ViewModel.AutoDetectExternalDisplay, Mode=OneWay}"
                                              OnContent="Enabled"
                                              OffContent="Disabled"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Rectangle Height="1" Fill="{ThemeResource AppSubtleDividerBrush}" />

                            <!-- Row 7: Preferred Presentation Display -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Preferred Presentation Display" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="Select a specific monitor for audience presentation output, or use automatic detection."
                                               FontSize="11"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{x:Bind ViewModel.AvailableDisplays, Mode=OneWay}"
                                          SelectedIndex="{x:Bind ViewModel.SelectedPreferredDisplayIndex, Mode=TwoWay}"
                                          MinWidth="180"
                                          Height="34"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ========================================================= -->
                    <!-- CATEGORY 4: KEYBOARD SHORTCUTS                            -->
                    <!-- ========================================================= -->
                    <Border Visibility="{x:Bind ViewModel.ShortcutsCategoryVisibility, Mode=OneWay}"
                            Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Keyboard Shortcuts"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="System-wide global hotkeys active during presentations."
                                               FontSize="11"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Reset to Defaults"
                                        Command="{x:Bind ViewModel.ResetHotkeysToDefaultCommand}"
                                        Style="{ThemeResource TextBlockButtonStyle}"
                                        FontSize="12"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <!-- Shortcut Filter Search -->
                            <TextBox Text="{x:Bind ViewModel.ShortcutSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="Filter shortcuts by name or keys..."
                                     FontSize="12" />

                            <!-- Shortcuts List -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredHotkeyBindings, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:HotkeyBinding">
                                        <Grid Padding="12,8"
                                              Margin="0,0,0,4"
                                              Background="{ThemeResource AppSurfaceElevatedBrush}"
                                              BorderBrush="{ThemeResource AppBorderBrush}"
                                              BorderThickness="1"
                                              CornerRadius="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Style="{StaticResource KeyBadgeBorderStyle}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind DisplayString}"
                                                           FontFamily="Consolas, Segoe UI"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ========================================================= -->
                    <!-- CATEGORY 5: DIAGNOSTICS & REPORTS                         -->
                    <!-- ========================================================= -->
                    <Border Visibility="{x:Bind ViewModel.DiagnosticsCategoryVisibility, Mode=OneWay}"
                            Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Diagnostics &amp; Error Reports"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}" />

                            <!-- Diagnostics Description & Privacy Banner -->
                            <Border Background="{ThemeResource AppSurfaceElevatedBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14,12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="100% Offline &amp; Local Diagnostics" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="Diagnostic reports are stored exclusively on your local device. Windows usernames, profile folders, email addresses, and secrets are automatically redacted before viewing or exporting. No telemetry or crash data is ever uploaded without your explicit action."
                                                   FontSize="11"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Diagnostics Actions Strip -->
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Command="{x:Bind ViewModel.OpenLogsFolderCommand}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                        BorderThickness="1"
                                        Padding="10,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xED25;" FontSize="13" />
                                        <TextBlock Text="Open Logs Folder" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.RefreshIncidentsCommand}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                        BorderThickness="1"
                                        Padding="10,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                        <TextBlock Text="Refresh Incidents" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.ClearDiagnosticsHistoryCommand}"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                        BorderThickness="1"
                                        Padding="10,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#FF6B6B" />
                                        <TextBlock Text="Clear Incident History" FontSize="12" Foreground="#FF6B6B" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Log Storage Details -->
                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" RowSpacing="6" Margin="0,4,0,0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Log Location:" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.LogsDirectoryPath, Mode=OneWay}" FontSize="12" FontFamily="Consolas, monospace" Foreground="{ThemeResource AppTextPrimaryBrush}" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Retention Policy:" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Up to 10 recent incident files, 30 days retention, bounded log size" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                            </Grid>

                            <!-- Recent Incidents Section -->
                            <TextBlock Text="Recent Error Incidents" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" Margin="0,8,0,0" />

                            <TextBlock Text="No error incidents recorded. System is operating normally."
                                       FontSize="12"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       Visibility="{x:Bind ViewModel.NoIncidentsVisibility, Mode=OneWay}"
                                       Margin="4,0,0,0" />

                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentIncidents, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="diagModels:DiagnosticIncident">
                                        <Grid Padding="12,10"
                                              Margin="0,0,0,6"
                                              Background="{ThemeResource AppSurfaceElevatedBrush}"
                                              BorderBrush="{ThemeResource AppBorderBrush}"
                                              BorderThickness="1"
                                              CornerRadius="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Id}" FontFamily="Consolas, monospace" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppAccentBrush}" />
                                                    <TextBlock Text="{x:Bind HResultHex}" FontFamily="Consolas, monospace" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind FormattedTimestamp}" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind SafeMessage}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind DisplayTitle}" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Click="OnViewIncidentDetailsClick"
                                                        Tag="{x:Bind}"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                                        BorderThickness="1"
                                                        Padding="8,5">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE7B3;" FontSize="12" />
                                                        <TextBlock Text="Details" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Click="OnCopyIncidentClick"
                                                        Tag="{x:Bind}"
                                                        Style="{StaticResource SubtleButtonStyle}"
                                                        BorderBrush="{ThemeResource AppBorderBrush}"
                                                        BorderThickness="1"
                                                        Padding="8,5">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                                        <TextBlock Text="Copy" FontSize="11" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>

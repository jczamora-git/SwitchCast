<Window
    x:Class="SwitchCast.Views.PresenterDockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:SwitchCast.Views"
    mc:Ignorable="d"
    Title="SwitchCast Presenter Dock">

    <!-- Floating Dock Surface with rounded border -->
    <Grid Background="Transparent">
        <Grid.Resources>
            <!-- Minimal Chromeless Button Style for Presenter Dock -->
            <Style x:Key="DockIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4,4" />
                <Setter Property="MinWidth" Value="26" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <Style x:Key="DockSubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource DockIconButtonStyle}" />

            <!-- Compact Badge Dropdown Button -->
            <Style x:Key="DockBadgeButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="5,2" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Border x:Name="DockCardBorder"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6,4"
                Margin="0">
            
            <StackPanel Spacing="3" VerticalAlignment="Center">
                <!-- ========================================================= -->
                <!-- PRIMARY TOOLBAR ROW                                       -->
                <!-- ========================================================= -->
                <Grid x:Name="PrimaryToolbarGrid" ColumnSpacing="4" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- Status Badge Pill -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Source Navigation (Prev, Dropdown, Next) -->
                        <ColumnDefinition Width="*" />
                        <!-- Mode Selector (A+L / A / L) -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Subtle Divider -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Live Action Controls (Pause, Blackout, Stop, Fullscreen) -->
                        <ColumnDefinition Width="Auto" />
                        <!-- More Actions -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Window Controls (Close) -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status Badge Pill -->
                    <Border Grid.Column="0"
                            Padding="6,2"
                            CornerRadius="6"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            ToolTipService.ToolTip="Presentation Live Status">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.StatusDisplayText, Mode=OneWay}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Source Navigation & Active Source Dropdown -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <!-- Previous Source -->
                        <Button Command="{x:Bind ViewModel.PreviousSourceCommand}"
                                IsEnabled="{x:Bind ViewModel.CanSwitchSources, Mode=OneWay}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="Previous Source (Ctrl+Shift+Left)">
                            <FontIcon Glyph="&#xE76B;" FontSize="11" />
                        </Button>

                        <!-- Active Source Button (Opens External Dropdown Menu) -->
                        <Button x:Name="ExpandedSourceButton"
                                Click="OnSourceSelectorClicked"
                                Style="{StaticResource DockBadgeButtonStyle}"
                                MaxWidth="180"
                                ToolTipService.ToolTip="{x:Bind ViewModel.SourceFullTooltip, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind ViewModel.ActiveSourceGlyph, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ActiveSourceTitle, Mode=OneWay}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           MaxLines="1"
                                           MaxWidth="135"
                                           VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Next Source -->
                        <Button Command="{x:Bind ViewModel.NextSourceCommand}"
                                IsEnabled="{x:Bind ViewModel.CanSwitchSources, Mode=OneWay}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="Next Source (Ctrl+Shift+Right)">
                            <FontIcon Glyph="&#xE76C;" FontSize="11" />
                        </Button>
                    </StackPanel>

                    <!-- Switching Mode Selector (A+L / A / L) (Opens External Dropdown Menu) -->
                    <Button x:Name="ExpandedModeButton"
                            Grid.Column="2"
                            Click="OnModeSelectorClicked"
                            Style="{StaticResource DockBadgeButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SwitchModeTooltip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.SwitchModeBadge, Mode=OneWay}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xE70D;" FontSize="8" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Subtle Divider -->
                    <Rectangle Grid.Column="3" Width="1" Height="14" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" VerticalAlignment="Center" />

                    <!-- Live Action Controls -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <!-- Video Mute / Unmute (Visible in primary row when video is active) -->
                        <Button Command="{x:Bind ViewModel.ToggleMediaMuteCommand}"
                                Visibility="{x:Bind views:PresenterDockWindow.BoolToVis(ViewModel.IsActiveSourceVideo), Mode=OneWay}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.MediaMuteButtonTooltip, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind ViewModel.MediaMuteButtonGlyph, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Button>

                        <!-- Pause / Resume Presentation -->
                        <Button Command="{x:Bind ViewModel.TogglePauseCommand}"
                                IsEnabled="{x:Bind ViewModel.IsPresenting, Mode=OneWay}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="Pause / Resume Live Presentation (Ctrl+Shift+P)">
                            <FontIcon Glyph="{x:Bind ViewModel.PauseButtonGlyph, Mode=OneWay}" FontSize="11" />
                        </Button>

                        <!-- Blackout -->
                        <Button Command="{x:Bind ViewModel.ToggleBlackoutCommand}"
                                IsEnabled="{x:Bind ViewModel.IsPresenting, Mode=OneWay}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="Toggle Blackout Privacy Screen (Ctrl+Shift+B)">
                            <FontIcon Glyph="{x:Bind ViewModel.BlackoutButtonGlyph, Mode=OneWay}" FontSize="11" />
                        </Button>

                        <!-- Stop Presenting -->
                        <Button Command="{x:Bind ViewModel.StopPresentationCommand}"
                                IsEnabled="{x:Bind ViewModel.IsPresenting, Mode=OneWay}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="Stop Live Presentation (Ctrl+Shift+S)">
                            <FontIcon Glyph="&#xE71A;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </Button>

                        <!-- Fullscreen Toggle (Presentation Output) -->
                        <Button Command="{x:Bind ViewModel.ToggleFullscreenCommand}"
                                IsEnabled="{x:Bind ViewModel.CanToggleFullscreen, Mode=OneWay}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.FullscreenButtonTooltip, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind ViewModel.FullscreenButtonGlyph, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Button>
                    </StackPanel>

                    <!-- More Actions (Opens External Dropdown Menu) -->
                    <Button x:Name="ExpandedMoreButton"
                            Grid.Column="5"
                            Click="OnMoreOptionsClicked"
                            Style="{StaticResource DockIconButtonStyle}"
                            ToolTipService.ToolTip="More Options">
                        <FontIcon Glyph="&#xE712;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>

                    <!-- Close Dock -->
                    <Button Grid.Column="6"
                            Command="{x:Bind ViewModel.CloseDockCommand}"
                            Style="{StaticResource DockIconButtonStyle}"
                            ToolTipService.ToolTip="Close Presenter Dock (Ctrl+Shift+D)">
                        <FontIcon Glyph="&#xE8BB;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>
                </Grid>

                <!-- ========================================================= -->
                <!-- ADAPTIVE VIDEO PLAYBACK & TIMELINE ROW                    -->
                <!-- ========================================================= -->
                <Grid x:Name="VideoPlaybackRowGrid"
                      ColumnSpacing="4"
                      Padding="2,2,2,0"
                      VerticalAlignment="Center"
                      Visibility="{x:Bind views:PresenterDockWindow.BoolToVis(ViewModel.IsActiveSourceVideo), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <!-- Transport Buttons (Restart, Rewind 10s, Play/Pause, Forward 10s) -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Duration Timeline Slider -->
                        <ColumnDefinition Width="*" />
                        <!-- Timecode Text (00:00 / 00:00) -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Video Transport Controls -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                        <!-- Restart Video -->
                        <Button Command="{x:Bind ViewModel.RestartVideoCommand}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="Restart Video (00:00)">
                            <FontIcon Glyph="&#xE777;" FontSize="11" />
                        </Button>

                        <!-- Seek Backward 10 Seconds -->
                        <Button Command="{x:Bind ViewModel.SeekBackward10Command}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="Seek Backward 10 Seconds">
                            <FontIcon Glyph="&#xEB9E;" FontSize="11" />
                        </Button>

                        <!-- Play / Pause Video -->
                        <Button Command="{x:Bind ViewModel.ToggleVideoPlaybackCommand}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.VideoPlaybackButtonTooltip, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind ViewModel.VideoPlaybackButtonGlyph, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Button>

                        <!-- Seek Forward 10 Seconds -->
                        <Button Command="{x:Bind ViewModel.SeekForward10Command}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="Seek Forward 10 Seconds">
                            <FontIcon Glyph="&#xEB9D;" FontSize="11" />
                        </Button>
                    </StackPanel>

                    <!-- Timeline Slider -->
                    <Slider x:Name="VideoTimelineSlider"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="{x:Bind ViewModel.VideoDurationSeconds, Mode=OneWay}"
                            Value="{x:Bind ViewModel.VideoPositionSeconds, Mode=TwoWay}"
                            StepFrequency="0.5"
                            SmallChange="1"
                            LargeChange="5"
                            Padding="0"
                            Margin="4,0"
                            VerticalAlignment="Center"
                            PointerCaptureLost="OnTimelineSliderPointerCaptureLost" />

                    <!-- Current Time / Total Duration -->
                    <TextBlock Grid.Column="2"
                               Text="{x:Bind ViewModel.VideoPositionText, Mode=OneWay}"
                               FontSize="10"
                               FontFamily="Consolas"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="2,0,4,0" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>

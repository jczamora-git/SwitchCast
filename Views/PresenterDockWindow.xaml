<Window
    x:Class="SwitchCast.Views.PresenterDockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:SwitchCast.Views"
    mc:Ignorable="d"
    Title="SwitchCast Presenter Dock">

    <!-- Floating Dock Surface with rounded border -->
    <Grid Background="Transparent">
        <Grid.Resources>
            <!-- Minimal Chromeless Button Style for Presenter Dock -->
            <Style x:Key="DockIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4,4" />
                <Setter Property="MinWidth" Value="26" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <Style x:Key="DockSubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource DockIconButtonStyle}" />

            <!-- Compact Badge Dropdown Button -->
            <Style x:Key="DockBadgeButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="5,2" />
                <Setter Property="MinHeight" Value="24" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Border x:Name="DockCardBorder"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6,3"
                Margin="0">
            
            <Grid VerticalAlignment="Center">
                <!-- ========================================================= -->
                <!-- EXPANDED MODE (Single Row, Minimal Floating Toolbar)       -->
                <!-- ========================================================= -->
                <Grid x:Name="ExpandedRootGrid"
                      ColumnSpacing="4"
                      VerticalAlignment="Center"
                      Visibility="{x:Bind views:PresenterDockWindow.InvertBoolToVis(ViewModel.IsCompactMode), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <!-- Status Badge Pill -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Source Navigation (Prev, Dropdown, Next) -->
                        <ColumnDefinition Width="*" />
                        <!-- Mode Selector (A+L / A / L) -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Subtle Divider -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Live Action Controls (Pause, Blackout, Stop) -->
                        <ColumnDefinition Width="Auto" />
                        <!-- More Actions -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Window Controls (Collapse, Close) -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status Badge Pill -->
                    <Border Grid.Column="0"
                            Padding="6,2"
                            CornerRadius="6"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            ToolTipService.ToolTip="Presentation Live Status">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.StatusDisplayText, Mode=OneWay}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Source Navigation & Active Source Dropdown -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <!-- Previous Source -->
                        <Button Command="{x:Bind ViewModel.PreviousSourceCommand}"
                                IsEnabled="{x:Bind ViewModel.CanSwitchSources, Mode=OneWay}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="Previous Source (Ctrl+Shift+Left)">
                            <FontIcon Glyph="&#xE76B;" FontSize="11" />
                        </Button>

                        <!-- Active Source Button (Opens External Dropdown Menu) -->
                        <Button x:Name="ExpandedSourceButton"
                                Click="OnSourceSelectorClicked"
                                Style="{StaticResource DockBadgeButtonStyle}"
                                MaxWidth="180"
                                ToolTipService.ToolTip="{x:Bind ViewModel.SourceFullTooltip, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7C5;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ActiveSourceTitle, Mode=OneWay}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           MaxLines="1"
                                           MaxWidth="135"
                                           VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Next Source -->
                        <Button Command="{x:Bind ViewModel.NextSourceCommand}"
                                IsEnabled="{x:Bind ViewModel.CanSwitchSources, Mode=OneWay}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="Next Source (Ctrl+Shift+Right)">
                            <FontIcon Glyph="&#xE76C;" FontSize="11" />
                        </Button>
                    </StackPanel>

                    <!-- Switching Mode Selector (A+L / A / L) (Opens External Dropdown Menu) -->
                    <Button x:Name="ExpandedModeButton"
                            Grid.Column="2"
                            Click="OnModeSelectorClicked"
                            Style="{StaticResource DockBadgeButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SwitchModeTooltip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.SwitchModeBadge, Mode=OneWay}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xE70D;" FontSize="8" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Subtle Divider -->
                    <Rectangle Grid.Column="3" Width="1" Height="14" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Margin="2,0" VerticalAlignment="Center" />

                    <!-- Live Action Controls -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <!-- Pause / Resume -->
                        <Button Command="{x:Bind ViewModel.TogglePauseCommand}"
                                IsEnabled="{x:Bind ViewModel.IsPresenting, Mode=OneWay}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="Pause / Resume Live Presentation (Ctrl+Shift+P)">
                            <FontIcon Glyph="{x:Bind ViewModel.PauseButtonGlyph, Mode=OneWay}" FontSize="11" />
                        </Button>

                        <!-- Blackout -->
                        <Button Command="{x:Bind ViewModel.ToggleBlackoutCommand}"
                                IsEnabled="{x:Bind ViewModel.IsPresenting, Mode=OneWay}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="Toggle Blackout Privacy Screen (Ctrl+Shift+B)">
                            <FontIcon Glyph="{x:Bind ViewModel.BlackoutButtonGlyph, Mode=OneWay}" FontSize="11" />
                        </Button>

                        <!-- Stop Presenting -->
                        <Button Command="{x:Bind ViewModel.StopPresentationCommand}"
                                IsEnabled="{x:Bind ViewModel.IsPresenting, Mode=OneWay}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="Stop Live Presentation (Ctrl+Shift+S)">
                            <FontIcon Glyph="&#xE71A;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </Button>
                    </StackPanel>

                    <!-- More Actions (Opens External Dropdown Menu) -->
                    <Button x:Name="ExpandedMoreButton"
                            Grid.Column="5"
                            Click="OnMoreOptionsClicked"
                            Style="{StaticResource DockIconButtonStyle}"
                            ToolTipService.ToolTip="More Options">
                        <FontIcon Glyph="&#xE712;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>

                    <!-- Window Controls (Collapse, Close) -->
                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                        <!-- Toggle Compact Mode -->
                        <Button Command="{x:Bind ViewModel.ToggleCompactModeCommand}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.CompactModeTooltip, Mode=OneWay}">
                            <FontIcon Glyph="&#xE73F;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>

                        <!-- Close Dock -->
                        <Button Command="{x:Bind ViewModel.CloseDockCommand}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="Close Presenter Dock (Ctrl+Shift+D)">
                            <FontIcon Glyph="&#xE8BB;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ========================================================= -->
                <!-- COMPACT MODE (Single Row, Ultra-Minimal Floating Toolbar)  -->
                <!-- ========================================================= -->
                <Grid x:Name="CompactRootGrid"
                      ColumnSpacing="3"
                      VerticalAlignment="Center"
                      Visibility="{x:Bind views:PresenterDockWindow.BoolToVis(ViewModel.IsCompactMode), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <!-- Status Dot -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Source Controls (Prev, Source Name, Next) -->
                        <ColumnDefinition Width="*" />
                        <!-- Mode Selector (A+L / A / L) -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Actions (Pause, Blackout) -->
                        <ColumnDefinition Width="Auto" />
                        <!-- More (Stop, Dashboard, Output) -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Controls (Expand, Close) -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Live Status Dot -->
                    <Border Grid.Column="0"
                            Padding="3,2"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind ViewModel.StatusDisplayText, Mode=OneWay}">
                        <Ellipse Width="6" Height="6" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Border>

                    <!-- Source Navigation in Compact Mode -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Command="{x:Bind ViewModel.PreviousSourceCommand}"
                                IsEnabled="{x:Bind ViewModel.CanSwitchSources, Mode=OneWay}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="Previous Source (Ctrl+Shift+Left)">
                            <FontIcon Glyph="&#xE76B;" FontSize="10" />
                        </Button>

                        <!-- Active Source Button in Compact Mode -->
                        <Button x:Name="CompactSourceButton"
                                Click="OnSourceSelectorClicked"
                                Style="{StaticResource DockBadgeButtonStyle}"
                                MaxWidth="125"
                                Padding="4,2"
                                ToolTipService.ToolTip="{x:Bind ViewModel.SourceFullTooltip, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.ActiveSourceTitle, Mode=OneWay}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           MaxLines="1"
                                           MaxWidth="85"
                                           VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE70D;" FontSize="8" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{x:Bind ViewModel.NextSourceCommand}"
                                IsEnabled="{x:Bind ViewModel.CanSwitchSources, Mode=OneWay}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="Next Source (Ctrl+Shift+Right)">
                            <FontIcon Glyph="&#xE76C;" FontSize="10" />
                        </Button>
                    </StackPanel>

                    <!-- Mode Selector in Compact Mode (Opens External Dropdown Menu) -->
                    <Button x:Name="CompactModeButton"
                            Grid.Column="2"
                            Click="OnModeSelectorClicked"
                            Style="{StaticResource DockBadgeButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SwitchModeTooltip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.SwitchModeBadge, Mode=OneWay}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                       VerticalAlignment="Center" />
                            <FontIcon Glyph="&#xE70D;" FontSize="7" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Compact Actions (Pause, Blackout) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <!-- Pause -->
                        <Button Command="{x:Bind ViewModel.TogglePauseCommand}"
                                IsEnabled="{x:Bind ViewModel.IsPresenting, Mode=OneWay}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="Pause / Resume (Ctrl+Shift+P)">
                            <FontIcon Glyph="{x:Bind ViewModel.PauseButtonGlyph, Mode=OneWay}" FontSize="10" />
                        </Button>

                        <!-- Blackout -->
                        <Button Command="{x:Bind ViewModel.ToggleBlackoutCommand}"
                                IsEnabled="{x:Bind ViewModel.IsPresenting, Mode=OneWay}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="Toggle Blackout (Ctrl+Shift+B)">
                            <FontIcon Glyph="{x:Bind ViewModel.BlackoutButtonGlyph, Mode=OneWay}" FontSize="10" />
                        </Button>
                    </StackPanel>

                    <!-- More Actions (Opens External Dropdown Menu) -->
                    <Button x:Name="CompactMoreButton"
                            Grid.Column="4"
                            Click="OnMoreOptionsClicked"
                            Style="{StaticResource DockIconButtonStyle}"
                            ToolTipService.ToolTip="More Options &amp; Stop Presenting">
                        <FontIcon Glyph="&#xE712;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Button>

                    <!-- Compact Controls (Expand, Close) -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                        <!-- Expand Button -->
                        <Button Command="{x:Bind ViewModel.ToggleCompactModeCommand}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.CompactModeTooltip, Mode=OneWay}">
                            <FontIcon Glyph="&#xE740;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>

                        <!-- Close Button -->
                        <Button Command="{x:Bind ViewModel.CloseDockCommand}"
                                Style="{StaticResource DockIconButtonStyle}"
                                ToolTipService.ToolTip="Close Presenter Dock (Ctrl+Shift+D)">
                            <FontIcon Glyph="&#xE8BB;" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

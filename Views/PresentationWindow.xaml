<Window
    x:Class="SwitchCast.Views.PresentationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SwitchCast.ViewModels"
    mc:Ignorable="d"
    Title="SwitchCast Presentation Output">

    <Grid Background="#000000">
        <!-- LAYER 1: Standby Screen -->
        <Grid Visibility="{x:Bind ViewModel.StandbyVisibility, Mode=OneWay}"
              Background="#0D0D0D"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14">
                <Border Width="64"
                        Height="64"
                        Background="#1A1A1A"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="32"
                        HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE768;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="SwitchCast"
                           Style="{ThemeResource TitleTextBlockStyle}"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="#FFFFFF" />
                <TextBlock Text="Ready to Present"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="#CCCCCC" />
                <TextBlock Text="Your presentation will appear here."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="#888888"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- LAYER 2: Live Presentation Video Canvas -->
        <Grid Visibility="{x:Bind ViewModel.LiveContentVisibility, Mode=OneWay}"
              Background="#000000"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Image Source="{x:Bind ViewModel.PresentationImageSource, Mode=OneWay}"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

            <!-- Paused Indicator Pill -->
            <Border Visibility="{x:Bind ViewModel.PausedIndicatorVisibility, Mode=OneWay}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="24"
                    Background="#D91A1A1A"
                    BorderBrush="#4DFFFFFF"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14,6">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE769;" FontSize="14" Foreground="#FFA500" />
                    <TextBlock Text="PAUSED — Content Frozen"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- LAYER 3: Blackout Overlay (Solid 100% Opaque Black Canvas) -->
        <Grid Visibility="{x:Bind ViewModel.BlackoutVisibility, Mode=OneWay}"
              Background="#000000"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch" />
    </Grid>
</Window>

<Window
    x:Class="SwitchCast.Views.PresenterDockMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:SwitchCast.Models"
    xmlns:views="using:SwitchCast.Views"
    mc:Ignorable="d"
    Title="SwitchCast Presenter Dock Menu">

    <Grid x:Name="RootGrid" Background="Transparent" KeyDown="OnRootGridKeyDown">
        <Border x:Name="MenuCardBorder"
                Background="{ThemeResource AppSurfaceElevatedBrush}"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6"
                Margin="0">
            
            <Grid>
                <!-- ========================================================= -->
                <!-- 1. QUEUED SOURCES MENU VIEW                               -->
                <!-- ========================================================= -->
                <Grid x:Name="SourcesMenuPanel" Visibility="Collapsed" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,2,4,2">
                        <TextBlock Text="Queued Sources"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="SourceCountText"
                                   FontSize="10"
                                   Foreground="{ThemeResource AppTextTertiaryBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Rectangle Grid.Row="1" Height="1" Fill="{ThemeResource AppSubtleDividerBrush}" Margin="0,1" />

                    <!-- Scrollable Sources List -->
                    <ListView Grid.Row="2"
                              x:Name="SourcesListView"
                              MaxHeight="260"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="OnSourceListItemClicked">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:CaptureSource">
                                <Grid ColumnSpacing="8" Padding="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <FontIcon Grid.Column="0" Glyph="{x:Bind TypeGlyph}" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />

                                    <!-- Title & Type text -->
                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   MaxLines="1"
                                                   ToolTipService.ToolTip="{x:Bind Title}" />
                                        <TextBlock Text="{x:Bind CategoryLabel}"
                                                   FontSize="9"
                                                   Foreground="{ThemeResource AppTextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   MaxLines="1" />
                                    </StackPanel>

                                    <!-- Interactive Queue Checkbox / Unqueue Action -->
                                    <CheckBox Grid.Column="2"
                                              IsChecked="True"
                                              Click="OnUnqueueCheckClicked"
                                              Tag="{x:Bind}"
                                              MinWidth="24"
                                              MinHeight="24"
                                              Padding="0"
                                              Margin="0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ToolTipService.ToolTip="Remove from presentation queue"
                                              AutomationProperties.Name="Remove from presentation queue" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty State -->
                    <StackPanel x:Name="EmptySourcesPanel"
                                Grid.Row="2"
                                Spacing="4"
                                Padding="16,12"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource AppTextTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No queued sources"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Queue sources from the Sources tab"
                                   FontSize="10"
                                   Foreground="{ThemeResource AppTextTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ========================================================= -->
                <!-- 2. SWITCHING MODE MENU VIEW                               -->
                <!-- ========================================================= -->
                <StackPanel x:Name="ModeMenuPanel" Visibility="Collapsed" Spacing="3">
                    <TextBlock Text="Switching Mode"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               Margin="4,2,4,2" />
                    <Rectangle Height="1" Fill="{ThemeResource AppSubtleDividerBrush}" Margin="0,1" />

                    <!-- Active + Live (A+L) -->
                    <Button x:Name="ModeActiveAndLiveButton"
                            Click="OnModeActiveAndLiveClicked"
                            Style="{StaticResource SubtleButtonStyle}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,5">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="CheckActiveAndLive" Grid.Column="0" Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock Text="Active + Live (A+L)" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock Text="Focus app window &amp; switch live output" FontSize="9" Foreground="{ThemeResource AppTextTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Active Only (A) -->
                    <Button x:Name="ModeActiveOnlyButton"
                            Click="OnModeActiveOnlyClicked"
                            Style="{StaticResource SubtleButtonStyle}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,5">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="CheckActiveOnly" Grid.Column="0" Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock Text="Active Only (A)" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock Text="Focus app window without changing output" FontSize="9" Foreground="{ThemeResource AppTextTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Live Only (L) -->
                    <Button x:Name="ModeLiveOnlyButton"
                            Click="OnModeLiveOnlyClicked"
                            Style="{StaticResource SubtleButtonStyle}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,5">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="CheckLiveOnly" Grid.Column="0" Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock Text="Live Only (L)" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                                <TextBlock Text="Switch live output without focusing app" FontSize="9" Foreground="{ThemeResource AppTextTertiaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- ========================================================= -->
                <!-- 3. MORE OPTIONS MENU VIEW                                 -->
                <!-- ========================================================= -->
                <StackPanel x:Name="MoreMenuPanel" Visibility="Collapsed" Spacing="3">
                    <TextBlock Text="Presenter Actions"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                               Margin="4,2,4,2" />
                    <Rectangle Height="1" Fill="{ThemeResource AppSubtleDividerBrush}" Margin="0,1" />

                    <!-- Stop Live Presentation (Visible if presenting) -->
                    <Button x:Name="StopPresentationButton"
                            Click="OnStopPresentationClicked"
                            Style="{StaticResource SubtleButtonStyle}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE71A;" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Stop Live Presentation" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Rectangle x:Name="StopDivider" Height="1" Fill="{ThemeResource AppSubtleDividerBrush}" Margin="0,1" />

                    <!-- Video Audio Controls (Visible when active source is video) -->
                    <StackPanel x:Name="VideoAudioPanel" Spacing="4" Padding="6,4">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind ViewModel.MediaMuteButtonGlyph, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Media Audio" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.MediaVolumePercentText, Mode=OneWay}"
                                       FontSize="10"
                                       FontFamily="Consolas"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Slider Grid.Column="0"
                                    Value="{x:Bind ViewModel.MediaVolume, Mode=TwoWay}"
                                    Minimum="0"
                                    Maximum="100"
                                    StepFrequency="1"
                                    SmallChange="5"
                                    LargeChange="10"
                                    Margin="0"
                                    Padding="0"
                                    VerticalAlignment="Center" />

                            <Button Grid.Column="1"
                                    Click="OnToggleMuteClicked"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Padding="6,4"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.MediaMuteButtonTooltip, Mode=OneWay}"
                                    VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind ViewModel.MediaMuteButtonGlyph, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Rectangle x:Name="AudioDivider" Height="1" Fill="{ThemeResource AppSubtleDividerBrush}" Margin="0,1" />

                    <!-- Control Dashboard -->
                    <Button Click="OnShowDashboardClicked"
                            Style="{StaticResource SubtleButtonStyle}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE80F;" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Control Dashboard" FontSize="11" Foreground="{ThemeResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Presentation Output Window -->
                    <Button Click="OnShowOutputWindowClicked"
                            Style="{StaticResource SubtleButtonStyle}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE714;" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Presentation Output" FontSize="11" Foreground="{ThemeResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Toggle Fullscreen Output (Visible when output is open) -->
                    <Button Click="OnToggleFullscreenClicked"
                            IsEnabled="{x:Bind ViewModel.CanToggleFullscreen, Mode=OneWay}"
                            Style="{StaticResource SubtleButtonStyle}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{x:Bind ViewModel.FullscreenButtonGlyph, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.FullscreenButtonTooltip, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppTextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ========================================================= -->
                <!-- 4. BACKGROUND MUSIC MENU VIEW                             -->
                <!-- ========================================================= -->
                <StackPanel x:Name="MusicMenuPanel" Visibility="Collapsed" Spacing="4">
                    <!-- Title Bar -->
                    <Grid Margin="4,2,4,2">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8D6;" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Background Music"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.BackgroundMusicVolumePercentText, Mode=OneWay}"
                                   FontSize="10"
                                   FontFamily="Consolas"
                                   Foreground="{ThemeResource AppTextTertiaryBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource AppSubtleDividerBrush}" Margin="0,1" />

                    <!-- Playlist Selection -->
                    <Grid ColumnSpacing="6" Margin="4,2,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Playlist:" FontSize="10" Foreground="{ThemeResource AppTextTertiaryBrush}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.ActivePlaylist, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  HorizontalAlignment="Stretch"
                                  FontSize="11"
                                  MinHeight="26"
                                  Padding="6,2" />
                    </Grid>

                    <!-- Current Track Display -->
                    <Border Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,5"
                            Margin="4,2,4,2">
                        <StackPanel Spacing="1">
                            <TextBlock Text="{x:Bind ViewModel.BackgroundMusicTrackTitle, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       MaxLines="1"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.BackgroundMusicTrackTitle, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.BackgroundMusicPositionText, Mode=OneWay}"
                                       FontSize="9"
                                       FontFamily="Consolas"
                                       Foreground="{ThemeResource AppTextTertiaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Seek Slider -->
                    <Slider x:Name="MusicSeekSlider"
                            Minimum="0"
                            Maximum="{x:Bind ViewModel.BackgroundMusicDurationSeconds, Mode=OneWay}"
                            Value="{x:Bind ViewModel.BackgroundMusicPositionSeconds, Mode=TwoWay}"
                            StepFrequency="1"
                            Margin="4,0"
                            Padding="0"
                            VerticalAlignment="Center"
                            PointerCaptureLost="OnMusicSeekSliderPointerCaptureLost" />

                    <!-- Transport Controls: Shuffle, Prev, Play/Pause, Next, Repeat -->
                    <Grid ColumnSpacing="4" HorizontalAlignment="Center" Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Shuffle Toggle -->
                        <Button Grid.Column="0"
                                Command="{x:Bind ViewModel.ToggleBackgroundMusicShuffleCommand}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Padding="6,4"
                                ToolTipService.ToolTip="{x:Bind ViewModel.BackgroundMusicShuffleTooltip, Mode=OneWay}">
                            <FontIcon Glyph="&#xE8B1;" FontSize="11"
                                      Opacity="{x:Bind ViewModel.BackgroundMusicShuffleOpacity, Mode=OneWay}"
                                      Foreground="{ThemeResource AppAccentBrush}" />
                        </Button>

                        <!-- Previous Track -->
                        <Button Grid.Column="1"
                                Command="{x:Bind ViewModel.PreviousBackgroundMusicTrackCommand}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Padding="6,4"
                                ToolTipService.ToolTip="Previous Track">
                            <FontIcon Glyph="&#xE76B;" FontSize="11" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        </Button>

                        <!-- Play / Pause -->
                        <Button Grid.Column="2"
                                Command="{x:Bind ViewModel.ToggleBackgroundMusicPlayPauseCommand}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Padding="8,4"
                                ToolTipService.ToolTip="{x:Bind ViewModel.BackgroundMusicPlayPauseTooltip, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind ViewModel.BackgroundMusicPlayPauseGlyph, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource AppAccentBrush}" />
                        </Button>

                        <!-- Next Track -->
                        <Button Grid.Column="3"
                                Command="{x:Bind ViewModel.NextBackgroundMusicTrackCommand}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Padding="6,4"
                                ToolTipService.ToolTip="Next Track">
                            <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource AppTextPrimaryBrush}" />
                        </Button>

                        <!-- Repeat Mode -->
                        <Button Grid.Column="4"
                                Command="{x:Bind ViewModel.CycleBackgroundMusicRepeatModeCommand}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Padding="6,4"
                                ToolTipService.ToolTip="{x:Bind ViewModel.BackgroundMusicRepeatTooltip, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind ViewModel.BackgroundMusicRepeatGlyph, Mode=OneWay}" FontSize="11"
                                      Foreground="{ThemeResource AppAccentBrush}" />
                        </Button>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource AppSubtleDividerBrush}" Margin="0,1" />

                    <!-- Volume and Mute Row -->
                    <Grid ColumnSpacing="6" Margin="4,2,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Slider Grid.Column="0"
                                Value="{x:Bind ViewModel.BackgroundMusicVolume, Mode=TwoWay}"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="1"
                                SmallChange="5"
                                LargeChange="10"
                                Margin="0"
                                Padding="0"
                                VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                Command="{x:Bind ViewModel.ToggleBackgroundMusicMuteCommand}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Padding="6,4"
                                ToolTipService.ToolTip="{x:Bind ViewModel.BackgroundMusicMuteTooltip, Mode=OneWay}"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="{x:Bind ViewModel.BackgroundMusicMuteGlyph, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppAccentBrush}" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
